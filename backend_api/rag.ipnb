from datasets import load_dataset
from sentence_transformers import SentenceTransformer
import pandas as pd
import numpy as np
import faiss
from transformers import pipeline
import openai
from flask import Flask, request, jsonify
from langchain_community.document_loaders import HuggingFaceDatasetLoader
from langchain.text_splitter import RecursiveCharacterTextSplitter
from langchain_huggingface import HuggingFaceEmbeddings
from langchain_community.vectorstores import FAISS
from transformers import AutoTokenizer, AutoModelForQuestionAnswering
from transformers import AutoTokenizer, pipeline
from langchain_huggingface.llms.huggingface_pipeline import HuggingFacePipeline
from langchain.chains import RetrievalQA
import sqlite3
from langchain.schema import Document
from datasets import load_dataset
from langchain.prompts import PromptTemplate
import warnings

warnings.filterwarnings("ignore", category=UserWarning)
warnings.filterwarnings("ignore", category=FutureWarning)

# 1. Load Dataset
dataset = load_dataset("Pranto11/TAaDs")
df = dataset['train'].to_pandas()

# 2. Preprocess Data
content_columns = ["title", "instructor", "learning_obj", "course_contents", "prerequisites", "readings", "applicability", "workload", "credits", "evaluation", "time", "frequency", "duration", "course_type", "remarks"]  # Adjust based on dataset columns
df['combined_text'] = df[content_columns].apply(lambda x: ' '.join(x.dropna().astype(str)), axis=1)

# 3. Generate Embeddings 
embedding_model_name = 'all-MiniLM-L6-v2' # Lightweight embedding model 
embedding_model = HuggingFaceEmbeddings(model_name=embedding_model_name) # Create FAISS VectorStore 

documents = df['combined_text'].tolist() 
faiss_store = FAISS.from_texts(documents, embedding_model) 



model_name = "Intel/dynamic_tinybert"

tokenizer = AutoTokenizer.from_pretrained(model_name, padding=True, truncation=True, max_length=512)
model = AutoModelForQuestionAnswering.from_pretrained(model_name)

question_answerer = pipeline(
    "question-answering", 
    model=model_name, 
    tokenizer=tokenizer,
    return_tensors='pt'
)

llm = HuggingFacePipeline(
    pipeline=question_answerer,
    model_kwargs={"temperature": 0.7, "max_length": 512},
)

# 4. Setup LangChain's RetrievalQA 
retriever = faiss_store.as_retriever(search_kwargs={"k": 4}) 

# qa = RetrievalQA.from_chain_type(llm=llm, chain_type="refine", retriever=retriever, return_source_documents=False)

# question = "Which courses are taken by Prof. Dr. Carsten Roppel?"
# result = qa.run({"query": question})
# print(result["result"])

# Define a custom prompt for LangChain 
template = """ 
You are a helpful assistant with access to a course catalog. Use the provided context to answer the user's question. 
Context: 
{context} 
Question: 
{question} 
Answer: """ 

prompt = PromptTemplate( 
    input_variables=["context", "question"], 
    template=template 
) 

# # Build the RetrievalQA chain 
qa_chain = RetrievalQA.from_chain_type( 
    llm=llm, 
    retriever=retriever, 
    return_source_documents=True, 
    chain_type_kwargs={"prompt": prompt} 
)



# 7. Flask App for Deployment 
app = Flask(__name__) 
@app.route('/generate', methods=['POST']) 
def generate(): 
    data = request.json 
    query = data.get('query', '') 
    print(query, 'query')
    if not query: 
        return jsonify({'error': 'Query is required'}), 400 
    try: 
        result = qa_chain({"query": query})
        # result = qa_chain({'query': query})
        response = result["result"]
        print('Working here')
        return jsonify({'response': response}) 
    except Exception as e: 
        # print("Error occured", e)
        return jsonify({'error': str(e)}), 500 

if __name__ == '__main__': 
    app.run(host='0.0.0.0', port=8080)